# placeholders: Scheme, UnitTestTarget
name: CI

# The fast gate for every PR and push to main: SwiftLint and the unit tests. The slow XCUITest suite lives in
# ui-tests.yml so PR feedback does not wait on it.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  # Cancel superseded runs on pull requests only; every push to main keeps its full result.
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  test:
    name: Lint & Unit Test
    # macos-26 ships stable Xcode 26.x. Bump to macos-27 once a stable
    # Xcode 27 runner is available and the project targets iOS 27.
    runs-on: macos-26
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v5

      - name: Select Xcode (latest stable on runner)
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Install build tools (XcodeGen, SwiftLint)
        run: brew install xcodegen swiftlint

      - name: Show toolchain
        run: |
          xcodebuild -version
          xcrun simctl list runtimes iOS

      # Only for XcodeGen projects; a committed .xcodeproj is used as is.
      - name: Generate Xcode project
        if: hashFiles('project.yml') != ''
        run: xcodegen generate

      # Errors fail the job; warnings show up as annotations on the PR.
      - name: SwiftLint
        run: |
          if [ -f .swiftlint.yml ]; then
            swiftlint lint --reporter github-actions-logging
          else
            echo "No .swiftlint.yml, skipping SwiftLint"
          fi

      - name: Pick latest iPhone simulator
        id: simulator
        run: |
          set -euo pipefail
          UDID=$(xcrun simctl list devices available --json | jq -r '
            .devices
            | to_entries
            | map(select(.key | test("SimRuntime.iOS-")))
            | sort_by(.key | sub(".*iOS-"; "") | split("-") | map(tonumber))
            | last
            | .value
            | map(select(.name | startswith("iPhone")))
            | first
            | .udid
          ')
          if [ -z "$UDID" ] || [ "$UDID" = "null" ]; then
            echo "::error::No iPhone simulator available on this runner"
            xcrun simctl list devices available
            exit 1
          fi
          echo "Using simulator $UDID"
          echo "udid=$UDID" >> "$GITHUB_OUTPUT"

      # Plain xcodebuild output (no xcpretty), so the Swift Testing summary shows up in the log.
      # Hosted runners start clean every time, so DerivedData lives in the per-job temp dir.
      - name: Build & Unit Test
        run: |
          xcodebuild test \
            -scheme {{Scheme}} \
            -destination "id=${{ steps.simulator.outputs.udid }}" \
            -derivedDataPath "$RUNNER_TEMP/DerivedData" \
            -resultBundlePath "$RUNNER_TEMP/TestResults.xcresult" \
            -only-testing:{{UnitTestTarget}}

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v5
        with:
          name: TestResults
          path: ${{ runner.temp }}/TestResults.xcresult
