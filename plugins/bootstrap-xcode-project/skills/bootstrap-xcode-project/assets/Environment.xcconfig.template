// placeholders: (none)
// Committed defaults. Values come from shell environment at build time.
// Local overrides live in Environment-Local.xcconfig (gitignored) — the
// optional include below lets each developer override without editing this file.

API_HOST_NAME = ${API_HOST_NAME}

// Runtime exposure happens through the app target's `info:` block in
// project.yml, which puts API_HOST_NAME = $(API_HOST_NAME) into a real
// Info.plist. Do NOT use INFOPLIST_KEY_* for custom keys — Xcode only
// honors a curated set of those and silently drops the rest.

#include? "Environment-Local.xcconfig"
