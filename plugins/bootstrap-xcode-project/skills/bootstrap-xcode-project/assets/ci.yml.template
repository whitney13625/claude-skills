# placeholders: ProjectName
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  test:
    name: Build & Test
    # macos-26 ships stable Xcode 26.x. Bump to macos-27 once a stable
    # Xcode 27 runner is available and the project targets iOS 27.
    runs-on: macos-26
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v5

      - name: Select Xcode (latest stable on runner)
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - name: Show toolchain
        run: |
          xcodebuild -version
          xcrun simctl list runtimes iOS

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        run: xcodegen generate

      # SwiftLint isn't run in CI by default — the project.yml pre-build
      # script still runs it locally during xcodebuild. To enforce in CI, add:
      #
      # - name: SwiftLint
      #   run: |
      #     which swiftlint >/dev/null || brew install swiftlint
      #     swiftlint            # add --strict once the baseline is clean

      - name: Pick latest iPhone simulator
        id: simulator
        run: |
          set -euo pipefail
          UDID=$(xcrun simctl list devices available --json | jq -r '
            .devices
            | to_entries
            | map(select(.key | test("SimRuntime.iOS-")))
            | sort_by(.key | sub(".*iOS-"; "") | split("-") | map(tonumber))
            | last
            | .value
            | map(select(.name | startswith("iPhone")))
            | first
            | .udid
          ')
          if [ -z "$UDID" ] || [ "$UDID" = "null" ]; then
            echo "::error::No iPhone simulator available on this runner"
            xcrun simctl list devices available
            exit 1
          fi
          NAME=$(xcrun simctl list devices available --json | jq -r --arg udid "$UDID" '
            [.devices[][]] | map(select(.udid == $udid)) | first | .name
          ')
          echo "Using simulator: $NAME ($UDID)"
          echo "udid=$UDID" >> "$GITHUB_OUTPUT"

      - name: Build & Test
        run: |
          set -o pipefail
          xcodebuild test \
            -scheme {{ProjectName}} \
            -destination "id=${{ steps.simulator.outputs.udid }}" \
            -resultBundlePath TestResults.xcresult \
            | xcpretty || xcodebuild test \
              -scheme {{ProjectName}} \
              -destination "id=${{ steps.simulator.outputs.udid }}"

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v5
        with:
          name: TestResults
          path: TestResults.xcresult
