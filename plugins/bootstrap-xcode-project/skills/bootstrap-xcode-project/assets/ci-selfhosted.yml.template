# placeholders: ProjectName, GitHubOwner
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  # Cancel superseded runs on pull requests only; every push to main keeps its full result.
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  test:
    name: Build & Test
    # Self-hosted runner registered once for the {{GitHubOwner}} organization and shared by its repos
    # (labels: self-hosted, macOS, ARM64). It uses the Xcode that `xcode-select -p` points to on that Mac.
    # If this job sits in "queued", the runner is offline or the Mac is asleep:
    #   gh api orgs/{{GitHubOwner}}/actions/runners
    runs-on: [self-hosted, macOS, ARM64]
    timeout-minutes: 30
    env:
      HOMEBREW_NO_AUTO_UPDATE: "1"
      HOMEBREW_NO_INSTALL_CLEANUP: "1"
    steps:
      - uses: actions/checkout@v5

      # The runner's non-interactive shell does not load the profile that puts Homebrew on PATH.
      - name: Add Homebrew to PATH
        run: |
          if [ ! -x /opt/homebrew/bin/brew ]; then
            echo "::error::Homebrew not found at /opt/homebrew/bin on the runner"
            exit 1
          fi
          echo "/opt/homebrew/bin" >> "$GITHUB_PATH"
          echo "/opt/homebrew/sbin" >> "$GITHUB_PATH"

      - name: Install build tools (XcodeGen, jq, SwiftLint)
        run: brew install xcodegen jq swiftlint

      - name: Show toolchain
        run: |
          xcodebuild -version
          xcodegen --version
          xcrun simctl list runtimes iOS

      - name: Generate Xcode project
        run: xcodegen generate

      # A throwaway simulator per run: the same Mac runs other repos' CI too, and data written by earlier runs
      # (HealthKit, keychain, files) would otherwise persist in a shared simulator.
      - name: Create a fresh iPhone simulator
        id: simulator
        run: |
          set -euo pipefail
          # Newest iOS runtime, and an iPhone that this runtime itself lists as supported. (The newest device
          # type Xcode knows is not always supported by the newest installed runtime: "Incompatible device".)
          LATEST=$(xcrun simctl list runtimes iOS available --json | jq -c '
            .runtimes | sort_by(.version | split(".") | map(tonumber)) | last')
          RUNTIME=$(echo "$LATEST" | jq -r '.identifier')
          DEVICE_TYPE=$(echo "$LATEST" | jq -r '
            [.supportedDeviceTypes[] | select(.productFamily == "iPhone")] | first | .identifier')
          if [ -z "$RUNTIME" ] || [ "$RUNTIME" = "null" ] || [ -z "$DEVICE_TYPE" ] || [ "$DEVICE_TYPE" = "null" ]; then
            echo "::error::No iOS runtime or iPhone device type on this runner"
            exit 1
          fi
          UDID=$(xcrun simctl create "CI-{{ProjectName}}-${GITHUB_RUN_ID}" "$DEVICE_TYPE" "$RUNTIME")
          echo "Using $DEVICE_TYPE on $RUNTIME ($UDID)"
          echo "udid=$UDID" >> "$GITHUB_OUTPUT"

      # Plain xcodebuild output (no xcpretty), so the Swift Testing summary shows up in the log.
      - name: Build & Test
        run: |
          xcodebuild test \
            -scheme {{ProjectName}} \
            -destination "id=${{ steps.simulator.outputs.udid }}" \
            -resultBundlePath TestResults.xcresult

      - name: Delete the simulator
        if: always() && steps.simulator.outputs.udid != ''
        run: xcrun simctl delete "${{ steps.simulator.outputs.udid }}" || true

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v5
        with:
          name: TestResults
          path: TestResults.xcresult
