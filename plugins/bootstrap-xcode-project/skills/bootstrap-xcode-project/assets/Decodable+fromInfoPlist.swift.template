import Foundation

extension Decodable {
    static func fromInfoPList(from bundle: Bundle = .main) throws -> Self {
        guard let infoDictionary = bundle.infoDictionary else {
            throw DecodingError.dataCorrupted(
                DecodingError.Context(
                    codingPath: [],
                    debugDescription: "Bundle \(bundle.bundleURL) has no Info.plist dictionary"
                )
            )
        }
        let rawData = try JSONSerialization.data(withJSONObject: infoDictionary)
        return try JSONDecoder().decode(Self.self, from: rawData)
    }
}
